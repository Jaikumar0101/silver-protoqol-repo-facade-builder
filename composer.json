{
    "name": "silver-protoqol/laravel-repo-facade-builder",
    "description": "Artisan generators for repositories, services, facades, enums, interfaces and traits — with first-class support for modular Laravel applications.",
    "type": "library",
    "keywords": [
        "laravel",
        "repository",
        "repository-pattern",
        "facade",
        "service",
        "enum",
        "modules",
        "modular",
        "artisan",
        "generator"
    ],
    "homepage": "https://github.com/Silver-ProtoQoL/laravel-repo-facade-builder",
    "license": "MIT",
    "authors": [
        {
            "name": "Silver-ProtoQoL",
            "homepage": "https://github.com/Silver-ProtoQoL"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SilverProtoQoL\\RepoFacadeBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverProtoQoL\\RepoFacadeBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "SilverProtoQoL\\RepoFacadeBuilder\\RepoFacadeBuilderServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "format": "pint",
        "lint": "pint --test",
        "check": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "test": "Run the PHPUnit test suite",
        "analyse": "Run PHPStan (Larastan) static analysis",
        "format": "Fix code style with Pint",
        "lint": "Check code style without changing files",
        "check": "Run style, static analysis and tests"
    }
}

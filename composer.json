{
    "name": "silver-protoqol/laravel-repo-facade-builder",
    "description": "Artisan generators for repositories, services, facades, enums, interfaces and traits — with first-class support for modular Laravel applications.",
    "type": "library",
    "keywords": [
        "laravel",
        "repository",
        "repository-pattern",
        "facade",
        "service",
        "enum",
        "modules",
        "modular",
        "artisan",
        "generator"
    ],
    "homepage": "https://github.com/Silver-ProtoQoL/laravel-repo-facade-builder",
    "license": "MIT",
    "authors": [
        {
            "name": "Silver-ProtoQoL",
            "homepage": "https://github.com/Silver-ProtoQoL"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "SilverProtoQoL\\RepoFacadeBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SilverProtoQoL\\RepoFacadeBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SilverProtoQoL\\RepoFacadeBuilder\\RepoFacadeBuilderServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
